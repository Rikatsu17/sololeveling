{
  "name": "ascend-life-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch backend/server.js",
    "build": "vite build",
    "start": "node backend/server.js",
    "test": "node --test backend/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write frontend backend scripts tests *.js *.json *.html",
    "db:backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.9",
    "vite": "^6.1.0"
  }
}
