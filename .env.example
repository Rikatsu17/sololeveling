# Optional external AI provider: a chat-completions-compatible endpoint.
# These variables must be exported in the server environment.
# If omitted, transparent local guidance remains available.
# AI_API_URL=https://your-provider.example/v1/chat/completions
# AI_API_KEY=your-secret-key
# AI_MODEL=your-model

# Optional server configuration
# PORT=3001
# HOST=127.0.0.1
# DATABASE_PATH=backend/data/ascend.db

# Optional account storage and HTTPS cookies
# ACCOUNTS_PATH=backend/data/accounts
# COOKIE_SECURE=true
